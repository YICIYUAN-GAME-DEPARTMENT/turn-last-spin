[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/card_action_menu.gd" id="1"]
[ext_resource type="Theme" path="res://ui/editorial_theme.tres" id="2"]
[ext_resource type="Script" path="res://scripts/ui/editorial_box.gd" id="3"]

[sub_resource type="SystemFont" id="MenuMono"]
font_names = PackedStringArray("Courier New", "Cascadia Mono", "Consolas", "monospace")
font_weight = 700
subpixel_positioning = 0

[node name="CardActionMenu" type="PanelContainer"]
custom_minimum_size = Vector2(276, 0)
offset_right = 276.0
offset_bottom = 148.0
mouse_filter = 0
theme = ExtResource("2")
script = ExtResource("1")

[node name="Frame" type="PanelContainer" parent="."]
layout_mode = 2
script = ExtResource("3")
ink_seed = 83
double_frame = true
padding_h = 18
padding_v = 16

[node name="Column" type="VBoxContainer" parent="Frame"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Heading" type="HBoxContainer" parent="Frame/Column"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleBlock" type="VBoxContainer" parent="Frame/Column/Heading"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="Eyebrow" type="Label" parent="Frame/Column/Heading/TitleBlock"]
layout_mode = 2
theme_override_colors/font_color = Color(0.337255, 0.321569, 0.294118, 1)
theme_override_fonts/font = SubResource("MenuMono")
theme_override_font_sizes/font_size = 10
text = "BALLOT // 本轮出牌决议"

[node name="Title" type="Label" parent="Frame/Column/Heading/TitleBlock"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.768627, 0.141176, 0.215686, 1)
theme_override_font_sizes/font_size = 18
text = "出牌  3"

[node name="Close" type="Button" parent="Frame/Column/Heading"]
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"GhostButton"
theme_override_font_sizes/font_size = 18
text = "×"

[node name="PointRow" type="HBoxContainer" parent="Frame/Column"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 10

[node name="Label" type="Label" parent="Frame/Column/PointRow"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "指定点数"

[node name="Points" type="OptionButton" parent="Frame/Column/PointRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 38)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
text = "1"

[node name="Effect" type="Label" parent="Frame/Column"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(226, 0)
layout_mode = 2
theme_override_colors/font_color = Color(0.337255, 0.321569, 0.294118, 1)
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="Confirm" type="Button" parent="Frame/Column"]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
mouse_default_cursor_shape = 2
theme_type_variation = &"CrimsonButton"
theme_override_font_sizes/font_size = 15
text = "♦  确认使用"

[node name="Choices" type="HBoxContainer" parent="Frame/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="Plus" type="Button" parent="Frame/Column/Choices"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
theme_type_variation = &"InkButton"
theme_override_font_sizes/font_size = 15
text = "＋3 顺转"

[node name="Minus" type="Button" parent="Frame/Column/Choices"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
size_flags_horizontal = 3
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 15
text = "−3 逆转"

[connection signal="pressed" from="Frame/Column/Heading/Close" to="." method="_on_cancel_pressed"]
[connection signal="item_selected" from="Frame/Column/PointRow/Points" to="." method="_on_points_selected"]
[connection signal="pressed" from="Frame/Column/Confirm" to="." method="_on_special_pressed"]
[connection signal="pressed" from="Frame/Column/Choices/Plus" to="." method="_on_plus_pressed"]
[connection signal="pressed" from="Frame/Column/Choices/Minus" to="." method="_on_minus_pressed"]
