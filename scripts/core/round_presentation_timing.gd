extends Resource
## 客户端与专服共用的开场、停盘和结算时序。

const DEFAULT_TURN_INTRO_SECONDS := 1.0
const INITIAL_CAMERA_RETURN_SECONDS := 0.35
const RESULT_CAMERA_LIFT_SECONDS := 0.27
const RESULT_REVEAL_SECONDS := 0.32
const RESULT_ROTATION_SECONDS := 0.78
const RESULT_NUMBER_PULSE_SECONDS := 0.24
const RESULT_CAMERA_RETURN_SECONDS := 0.48

const REWARD_INTRO_SECONDS := 0.13
const REWARD_RATE_SECONDS := 0.38
const REWARD_OPERATOR_SECONDS := 0.16
const REWARD_STEPS_SECONDS := 0.57
const REWARD_SHARE_SECONDS := 0.27
const REWARD_TOTAL_SECONDS := 0.51
const REWARD_READ_SECONDS := 0.49
const REWARD_FLIGHT_SECONDS := 0.48

const REWARD_SEQUENCE_SECONDS := (
	REWARD_INTRO_SECONDS + REWARD_RATE_SECONDS + REWARD_OPERATOR_SECONDS + REWARD_STEPS_SECONDS
	+ REWARD_SHARE_SECONDS + REWARD_TOTAL_SECONDS + REWARD_READ_SECONDS + REWARD_FLIGHT_SECONDS
)
const RESULT_WHEEL_SECONDS := (
	RESULT_CAMERA_LIFT_SECONDS + RESULT_REVEAL_SECONDS + RESULT_ROTATION_SECONDS
	+ RESULT_NUMBER_PULSE_SECONDS + RESULT_CAMERA_RETURN_SECONDS
)

@export_range(0.1, 5.0, 0.05, "suffix:s") var turn_intro_seconds := DEFAULT_TURN_INTRO_SECONDS
@export_range(0.0, 5.0, 0.05, "suffix:s") var wheel_stop_hold := 1.0
